PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Today: local SQLite database. The server creates this file automatically.
DATABASE_URL=sqlite:./data/ai-eip.db

# AI provider layer. The demo works fully offline with AI_ENABLED=false
# (deterministic fallback). OpenRouter free models cost $0; xAI API usage is
# separately billed — never commit a real key.
AI_ENABLED=false
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
XAI_API_KEY=
XAI_MODEL=grok-4.5
